# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Raw HTML cache from mevzuat.gov.tr (regenerate with the ingest script)
data/raw/
# Embedding cache (rebuild with: uv run python -m turkish_legal_assistant.vectors)
data/embeddings_*
.DS_Store

# Intermediate files of the verified training set (rebuild with: uv run python -m turkish_legal_assistant.verify)
data/finetune/v2/work/

# Trained LoRA adapters (rebuild with: uv run python -m turkish_legal_assistant.finetune)
models/

# Local secrets (template: .env.example)
.env

# Social-media animation (videos and the files that render them), not part of the repo
docs/animation/
