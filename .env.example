# Copy to .env and fill in. docker compose reads it automatically.

# gemini (default, needs GEMINI_API_KEY), claude (needs ANTHROPIC_API_KEY)
# or local (the fine-tuned student; start with: docker compose --profile local up)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=
